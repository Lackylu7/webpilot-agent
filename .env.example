# Optional. If omitted, WebPilot uses deterministic demo planning and extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Browser execution controls.
WEBPILOT_BROWSER_HEADLESS=true
WEBPILOT_MAX_PAGES=5
WEBPILOT_TIMEOUT_MS=15000

# Local product controls.
WEBPILOT_DATA_DIR=./data
WEBPILOT_HISTORY_LIMIT=100

# Set to true for portfolio demos that should not touch the live web.
WEBPILOT_DEMO_MODE=false
